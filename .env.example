# Copy to .env and fill in ONE platform block for the validation model.

# --- Claude API (Anthropic) - key from console.anthropic.com
CLAUDE_PLATFORM=anthropic
CLAUDE_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# --- Claude on Google Vertex AI - auth: gcloud auth application-default login
# CLAUDE_PLATFORM=vertex
# CLAUDE_MODEL=claude-haiku-5-5
# VERTEX_PROJECT_ID=
# VERTEX_REGION=global

# --- Claude on Amazon Bedrock - auth: your AWS profile / credentials
# CLAUDE_PLATFORM=bedrock
# CLAUDE_MODEL=anthropic.claude-haiku-5-5   # or BEDROCK_MODEL_ID=arn:aws:bedrock:... (inference profile ARN)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=                         # only for temporary keys (access key starts with ASIA)

# --- Local model through Ollama (not Claude) - no key, nothing leaves this machine
#     Install Ollama from ollama.com, then run:  ollama pull qwen2.5:7b
# CLAUDE_PLATFORM=local
# LOCAL_MODEL=qwen2.5:7b
# LOCAL_ESCALATION_MODEL=qwen2.5:14b   # optional second reviewer when confidence is low
# LOCAL_NUM_CTX=32768             # raise for long documents (uses more memory)

# --- OCR (PaddleOCR, always local)
OCR_MODE=ppocr                    # ppocr (PP-OCRv6) | auto (picks PaddleOCR-VL-1.6 for tables) | vl
OCR_DEVICE=cpu                    # gpu:0 on a machine with a GPU
OCR_MODEL_SIZE=small              # PP-OCRv6: tiny (~1 s/page on a laptop) | small (~2 s) | medium (~35 s; for a GPU)

# --- Confidence: below the threshold (0-100), ESCALATION_MODEL reviews again;
#     if it is still below, the result is flagged for human review.
#     With a local model, LOCAL_ESCALATION_MODEL is the second reviewer; without it,
#     low confidence goes straight to human review.
CONFIDENCE_THRESHOLD=80
# ESCALATION_MODEL=claude-sonnet-5-5   # anthropic.claude-sonnet-5-5 on Bedrock

# Optional
MAX_TOKENS=16000
AMOUNT_TOLERANCE=0.01
# TEMPLATES_DB=templates.db

# Ask for a password on the page (any user name). Set it whenever others could reach the page.
# APP_PASSWORD=
