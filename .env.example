# Copy to .env and set what you need; everything has a default.

# --- Validation model: LLM_PROVIDER = ollama (default) | anthropic | vertex | bedrock
#     LLM_MODEL and LLM_ESCALATION_MODEL default to the provider's own models.

# Ollama, on this machine or your own server - no key, nothing leaves your machines.
#     Install Ollama from ollama.com, then run:  ollama pull qwen2.5:7b
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
# LLM_ESCALATION_MODEL=qwen2.5:14b   # optional second reviewer when confidence is low
# OLLAMA_NUM_CTX=32768               # raise for long documents (uses more memory)
# OLLAMA_HOST=http://127.0.0.1:11434

# Claude API (optional: pip install -r requirements-claude.txt) - key from console.anthropic.com
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-5-5
# LLM_ESCALATION_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=
# MAX_TOKENS=16000

# Claude on Google Vertex AI (optional) - auth: gcloud auth application-default login
# LLM_PROVIDER=vertex
# VERTEX_PROJECT_ID=
# VERTEX_REGION=global

# Claude on Amazon Bedrock (optional) - auth: your AWS profile / credentials
# LLM_PROVIDER=bedrock
# LLM_MODEL=anthropic.claude-haiku-5-5   # or an inference profile ARN: arn:aws:bedrock:...
# LLM_ESCALATION_MODEL=                  # a second ARN, if LLM_MODEL is an ARN
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=                     # only for temporary keys (access key starts with ASIA)

# --- Confidence: below the threshold (0-100), LLM_ESCALATION_MODEL reviews again;
#     if it is still below, the result is flagged for human review.
CONFIDENCE_THRESHOLD=80

# --- OCR (PaddleOCR, always on this machine)
OCR_MODE=ppocr                    # ppocr (PP-OCRv6 + layout) | hybrid (+ PaddleOCR-VL for tables, seals, charts,
                                  #   kept only where PP-OCR read the same amounts; needs requirements-vl.txt, a GPU
                                  #   in practice) | auto | vl
OCR_DEVICE=cpu                    # gpu:0 on a machine with a GPU
OCR_MODEL_SIZE=small              # PP-OCRv6: tiny (~1 s/page on a laptop) | small (~2 s) | medium (~35 s; for a GPU)
# Layout: finds each page's zones (title, text, table, header, footer, ...) to read blocks in order.
# Used for scans and for typed PDF pages. Empty: order pages by geometry alone (no model).
LAYOUT_MODEL=PP-DocLayout_plus-L  # ~8 s/page on a laptop CPU; PP-DocLayout-S is ~1 s but finds fewer zones
# LAYOUT_THRESHOLD=0.3

# Optional
AMOUNT_TOLERANCE=0.01
# TEMPLATES_DB=templates.db

# --- Web page
# Ask for a password on the page (any user name). Set it whenever others could reach the page.
# APP_PASSWORD=
# APP_HOST=127.0.0.1                 # anything else lets other machines connect: then APP_PASSWORD,
# APP_PORT=8000                      # TLS_CERT_FILE and TLS_KEY_FILE are required (HTTPS)
# TLS_CERT_FILE=
# TLS_KEY_FILE=
# JOB_RETENTION_MINUTES=60           # results are deleted from memory this long after they finish

# --- Limits on uploaded files (protect against oversized files and decompression bombs)
# MAX_FILE_MB=25
# MAX_DOCUMENTS=20
# MAX_UNZIPPED_MB=200                # what an .xlsx/.docx may unpack to
# MAX_PAGES=50                       # PDF pages and TIFF frames
# MAX_IMAGE_MEGAPIXELS=40

# Secrets (API keys, passwords) in this file: keep the project folder out of OneDrive or other
# synced folders, or the keys are copied to the cloud.
