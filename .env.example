# Copy to .env and fill in ONE platform block for the validation model.

# --- Claude API (Anthropic) - key from console.anthropic.com
CLAUDE_PLATFORM=anthropic
CLAUDE_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# --- Claude on Google Vertex AI - auth: gcloud auth application-default login
# CLAUDE_PLATFORM=vertex
# CLAUDE_MODEL=claude-haiku-5-5
# VERTEX_PROJECT_ID=
# VERTEX_REGION=global

# --- Claude on Amazon Bedrock - auth: your AWS profile / credentials
# CLAUDE_PLATFORM=bedrock
# CLAUDE_MODEL=anthropic.claude-haiku-5-5
# AWS_REGION=us-east-1

# --- Local model through Ollama (not Claude) - no key, nothing leaves this machine
#     Install Ollama from ollama.com, then run:  ollama pull qwen2.5:7b
# CLAUDE_PLATFORM=local
# LOCAL_MODEL=qwen2.5:7b
# LOCAL_NUM_CTX=32768             # raise for long documents (uses more memory)

# --- OCR (PaddleOCR, always local)
OCR_MODE=auto                     # auto | ppocr (fastest, for CPU-only laptops) | vl
OCR_DEVICE=cpu                    # gpu:0 on a machine with a GPU

# Optional
MAX_TOKENS=16000
AMOUNT_TOLERANCE=0.01
# TEMPLATES_DB=templates.db
