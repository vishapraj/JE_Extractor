# Copy to .env and fill in ONE platform block.
#
# Default model is Claude Sonnet 5.5. The model must support structured outputs:
# Claude Sonnet 5.5, Sonnet 5, Opus 5.5, Opus 5, Haiku 5.5 (Claude Sonnet 4.6 does NOT).

# --- Claude API (Anthropic) - key from console.anthropic.com
CLAUDE_PLATFORM=anthropic
CLAUDE_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# --- Claude on Google Vertex AI - auth: gcloud auth application-default login
# CLAUDE_PLATFORM=vertex
# CLAUDE_MODEL=claude-sonnet-5-5
# VERTEX_PROJECT_ID=
# VERTEX_REGION=global

# --- Claude on Amazon Bedrock - auth: your AWS profile / credentials
# CLAUDE_PLATFORM=bedrock
# CLAUDE_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# AWS_REGION=us-east-1
# Only if you have no AWS profile set up (aws configure):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- Local model through Ollama (not Claude) - no key, files stay on this machine
#     Install Ollama from ollama.com, then run:  ollama pull qwen2.5vl:7b
# CLAUDE_PLATFORM=local
# LOCAL_MODEL=qwen2.5vl:7b        # qwen2.5vl:3b is faster but less accurate
# LOCAL_NUM_CTX=16384             # raise for long documents (uses more memory)

# Optional
MAX_TOKENS=16000
PARALLEL_FILES=4
